{
    "name": "homepage",
    "version": "0.0.1",
    "description": "Russell McWhae’s portfolio",
    "scripts": {
        "dev": "vite dev --port 4000 --host",
        "build": "rm -rf .vercel_build_output && vite build",
        "preview": "vite preview --port 4000",
        "kill": "rm -rf node_modules",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write .",
        "test": "playwright test",
        "test:ui": "playwright test --ui",
        "test:headed": "playwright test --headed",
        "test:debug": "playwright test --debug",
        "postinstall": "pnpm rebuild sharp"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@imagekit/nodejs": "^7.6.1",
        "@playwright/test": "^1.60.0",
        "@sveltejs/adapter-vercel": "^6.3.3",
        "@sveltejs/kit": "^2.60.1",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@types/node": "^25.9.1",
        "@types/unist": "^3.0.3",
        "@typescript-eslint/eslint-plugin": "^8.59.4",
        "@typescript-eslint/parser": "^8.59.4",
        "eslint": "^10.4.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.17.1",
        "mdsvex": "^0.12.7",
        "node-gyp": "^12.3.0",
        "photoswipe": "^5.4.4",
        "prettier": "~3.8.3",
        "prettier-plugin-svelte": "^3.5.2",
        "rehype-autolink-headings": "^7.1.0",
        "rehype-external-links": "^3.0.0",
        "rehype-slug": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "sass": "^1.99.0",
        "svelte": "^5.55.9",
        "svelte-gallery": "^1.3.5",
        "svelte-icons": "^2.1.0",
        "svimg": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.4",
        "vite": "^8.0.14"
    },
    "type": "module",
    "dependencies": {
        "@imagekit/javascript": "^5.4.0",
        "@vercel/analytics": "^2.0.1",
        "@vercel/speed-insights": "^2.0.0",
        "dateformat": "^5.0.3",
        "reading-time": "^1.5.0",
        "sharp": "^0.34.5",
        "unist-util-visit": "^5.1.0"
    }
}
