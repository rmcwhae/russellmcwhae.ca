{
    "name": "homepage",
    "version": "0.0.1",
    "description": "Russell McWhae’s portfolio",
    "scripts": {
        "dev": "vite dev --port 4000 --host",
        "build": "rm -rf .vercel_build_output && vite build",
        "preview": "vite preview --port 4000",
        "kill": "rm -rf node_modules",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write .",
        "test": "playwright test",
        "test:ui": "playwright test --ui",
        "test:headed": "playwright test --headed",
        "test:debug": "playwright test --debug"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@imagekit/nodejs": "^7.12.1",
        "@playwright/test": "^1.63.0",
        "@sveltejs/adapter-vercel": "^6.3.4",
        "@sveltejs/kit": "^2.70.3",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@types/node": "^26.6.2",
        "@types/unist": "^3.0.3",
        "@typescript-eslint/eslint-plugin": "^8.70.1",
        "@typescript-eslint/parser": "^8.70.1",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.23.0",
        "jiti": "^2.7.0",
        "mdsvex": "^0.12.8",
        "node-gyp": "^13.0.2",
        "photoswipe": "^5.4.4",
        "prettier": "~3.9.8",
        "prettier-plugin-svelte": "^4.1.1",
        "rehype-autolink-headings": "^7.1.0",
        "rehype-external-links": "^3.0.0",
        "rehype-slug": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "sass": "^1.104.1",
        "svelte": "^5.57.1",
        "svelte-gallery": "^1.3.5",
        "svelte-icons": "^2.1.0",
        "svimg": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.3.0"
    },
    "type": "module",
    "packageManager": "pnpm@10.28.0",
    "dependencies": {
        "@imagekit/javascript": "^5.5.1",
        "@vercel/analytics": "^2.0.1",
        "@vercel/speed-insights": "^2.0.0",
        "dateformat": "^5.0.3",
        "reading-time": "^1.5.0",
        "sharp": "^0.35.4",
        "unist-util-visit": "^5.1.0"
    }
}
